# NeuroVision AI - Environment Configuration Example
# Copy this file to .env and customize as needed: cp .env.example .env

FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-a-strong-random-key-here-neurovision-2026
PORT=5000
HOST=0.0.0.0

# Model Configuration
MODEL_PATH=models/efficientnet_brain_tumor.keras
BATCH_SIZE=32
EPOCHS_PHASE_1=10
EPOCHS_PHASE_2=15

# Database Configuration
DATABASE_PATH=database/neurovision.db
